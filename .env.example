# Application
APP_NAME=AI Trading Platform
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Trading safety: keep live execution disabled until the account and limits are verified.
TRADING_MODE=demo
LIVE_TRADING_ENABLED=false
TRADING_EXECUTION_ENABLED=false
LIVE_TRADING_CONFIRMATION=
MAX_LIVE_LOTS=0.01
LIVE_AUTO_MAX_RISK_PERCENT=0.25
LIVE_AUTO_MAX_SESSION_LOSS_PERCENT=1.0
LIVE_AUTO_MAX_OPEN_RISK_PERCENT=0.75
LIVE_AUTO_MAX_POSITIONS=3
LIVE_AUTO_MAX_ORDERS=3

# Database (used in a later phase)
POSTGRES_DB=trading_platform
POSTGRES_USER=trading_app
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql+psycopg://trading_app:change-me-before-use@localhost:5432/trading_platform

# Redis remains optional until a real-time workload requires it.
REDIS_URL=redis://localhost:6379/0

# Never commit real credentials. MT5 integration is added in a later phase.
# Phase 3 uses this optional path only for an explicit, read-only diagnostic.
MT5_TERMINAL_PATH=
AUTO_START_MT5=false
MT5_CONNECTION_TIMEOUT_MS=60000
MARKET_DATA_MAX_AGE_SECONDS=10
ECONOMIC_CALENDAR_URL=
ECONOMIC_CALENDAR_TIMEOUT_SECONDS=5
ECONOMIC_CALENDAR_MAX_AGE_SECONDS=900
DEMO_EXECUTION_ENABLED=false
MAX_DEMO_LOTS=0.1
DEMO_AUTO_TRADE_MAX_RISK_PERCENT=0.25
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
